---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  currentUrl?: string;
  /** Share image for og:image and twitter:image: an absolute or root-relative URL. */
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Henrique Pacheco',
  description = "I'm Henrique, a software engineer from Braga, Portugal. I've been building software since 2014 and working remotely since 2019.",
  currentUrl = '/',
  image = '/og.png',
  type = 'website',
} = Astro.props;

// Without the trailing slash the build adds, to match the site's own links and the RSS feed.
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const imageUrl = new URL(image, Astro.site);
const isDefaultImage = image === '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content="Henrique Pacheco" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Henrique Pacheco" />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="alternate" type="application/rss+xml" title="Henrique Pacheco — Blog" href={new URL('/rss.xml', Astro.site)} />
    <meta name="google-site-verification" content="btqk2CUsVOmjOPgskaPb_R7MazjerdUKxqwaYNUTM0o" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-work-sans" preload={[{ weight: '400' }, { weight: '700' }]} />
    <Font cssVariable="--font-mukta" preload={[{ weight: '700' }]} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div id="screen-frame" data-home={currentUrl === '/' ? 'true' : 'false'} aria-hidden="true"></div>
    <Header currentUrl={currentUrl} />
    <main>
      <slot />
    </main>
    <Footer />
    <Cursor />
    <!-- Vercel's script no longer honours the va-disable localStorage key, so we check it
         ourselves: set it in a browser (any value) to keep that browser out of the stats.
         Inline so it runs before <Analytics /> reads window.webAnalyticsBeforeSend. -->
    <script is:inline>
      window.webAnalyticsBeforeSend = (event) => {
        try {
          if (localStorage.getItem('va-disable') !== null) return null;
        } catch {}
        return event;
      };
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  #screen-frame {
    position: fixed;
    inset: 0;
    border: 0px solid var(--color-primary);
    pointer-events: none;
    z-index: 100;
    transition: border-width 0.2s var(--ease) 0.3s;
  }

  #screen-frame[data-home='true'].visible {
    border-width: 16px;
  }

  @media (max-width: 544px) {
    #screen-frame[data-home='true'].visible {
      border-width: 8px;
    }
  }
</style>

<script>
  const frame = document.getElementById('screen-frame');
  if (frame && frame.dataset.home === 'true') {
    requestAnimationFrame(() => {
      frame.classList.add('visible');
    });
  }
</script>

<script>
  // Delegated on document so any link to Lume or Good Work counts, including ones in posts.
  import { track } from '@vercel/analytics';

  const PROJECT_HOSTS: Array<[string, string]> = [
    ['lume-app.dev', 'lume'],
    ['good-work.app', 'good-work'],
  ];

  function projectFor(hostname: string): string | undefined {
    const match = PROJECT_HOSTS.find(([host]) => hostname === host || hostname.endsWith(`.${host}`));
    return match?.[1];
  }

  function onProjectClick(event: MouseEvent) {
    try {
      if (event.type === 'auxclick' && event.button !== 1) return;
      const link = (event.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      const project = projectFor(new URL(link.href).hostname);
      if (!project) return;
      track('project_click', { project, path: window.location.pathname });
    } catch {}
  }

  document.addEventListener('click', onProjectClick);
  document.addEventListener('auxclick', onProjectClick);
</script>
