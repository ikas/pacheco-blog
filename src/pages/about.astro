---
import Layout from '../layouts/Layout.astro';

const experiences = [
  {
    from: 'Oct 2025',
    to: 'Now',
    title: 'Senior Tech Lead @ Deel',
    skills: 'Node.JS / Typescript / Docker / Kubernetes / AWS',
    items: [
      'Leading the engineering teams of the Payroll Core vertical, working closely with their tech leads.',
      'Supporting tech leads in making architectural decisions, upholding code quality, and driving delivery.',
      'Bridging engineering, product, and design to align on direction and ship impactful payroll features.',
    ],
  },
  {
    from: 'Feb 2023',
    to: 'Oct 2025',
    title: 'Tech Lead @ Deel',
    skills: 'Node.JS / Typescript / Docker / Kubernetes / AWS',
    items: [
      'Led the G2N (Gross to Net) team, one of the most central parts of payroll processing at Deel.',
      'Guided the team in building features that ensure the quality and accuracy of payroll runs at global scale.',
      'Supported engineers in technical growth while driving delivery of complex, high-impact payroll capabilities.',
    ],
  },
  {
    from: 'Jan 2022',
    to: 'Feb 2023',
    title: 'Backend Engineer @ Deel',
    skills: 'Node.JS / Typescript / Docker / Kubernetes / AWS',
    items: [
      'Helped bring the Global Payroll product to life, supporting the first customers from day one.',
      'Contributed to building a platform that enables payroll processing across multiple countries globally.',
      'Handled the growth and scale challenges as the product expanded its customer base.',
    ],
  },
  {
    from: '2019',
    to: '2021',
    title: 'Backend Engineer @ Vizzuality',
    skills: 'Node.JS / Ruby / Docker / Kubernetes / AWS',
    items: [
      'Designing and developing cross-functional systems to process and serve large amounts of data in the cloud, often in real-time, and ensuring their craftsmanship, availability, resilience, and scalability.',
      'Technological stack composed of NodeJS, Rails and some Python, as well as technologies such as Kubernetes, Terraform and AWS for infrastructure management.',
      'Ensuring software quality, robustness and compliance with standards by reviewing code, documenting, and creating automated tests.',
    ],
  },
  {
    from: '2018',
    to: '2019',
    title: 'Remote Software Engineer',
    skills: 'JavaScript / Node.JS / React Native / React / Redux',
    items: [
      'Participation in multiple software projects as part of a network of remote workers.',
      'Development of micro services based in Node.JS (Express) and MySQL.',
      'UI/UX of multiple mobile applications using React Native.',
    ],
  },
  {
    from: '2014',
    to: '2018',
    title: 'Beevo',
    skills: 'E-commerce / PHP / HTML / CSS / JavaScript',
    items: [
      'Development of web platforms focused on B2B/B2C e-commerce targeted at medium and large scale businesses.',
      'Participation in the development of the product using Phalcon framework.',
      'Projects for national customers and alongside international teams.',
      'Full stack web development & Product team leader during the last year.',
    ],
  },
  {
    from: '2011',
    to: '2018',
    title: 'BSc + MSc Software Engineering',
    skills: 'University of Minho, Braga, Portugal',
    items: [
      "Master's thesis on usability engineering - development of widgets for an open-source prototyping tool (PVSio-Web).",
      'Specialization in Business Intelligence and Applicational Architectures.',
      'Also a bit of natural language processing and software testing.',
    ],
  },
];
---

<Layout title="About — Henrique Pacheco" currentUrl="/about">
  <section class="about-page">
    <div class="container">
      <h1 class="section-heading">Hello</h1>
      <p class="bio">I'm Henrique, a software engineer from Braga, Portugal. I've been building software since 2014 and working remotely since 2019. I'm also a father of 2.</p>
      <p class="bio">Today I'm a Senior Tech Lead at Deel, where I work with the teams that own Deel's payroll processing engine. On the side, I build my own products, Lume and Good Work.</p>

      <h2 class="section-heading build-heading">How I build</h2>
      <p class="bio">I ship Mac, iPhone and web products in my spare time by directing AI coding agents through an agent orchestrator I built. For each change, the agents plan it, implement it, test it, check the result in a browser and review it. I decide what to build, design it, review the result and release it.</p>
      <p class="bio">That's how I build my side projects.</p>
      <p class="bio">Want to know more?</p>
      <a class="contact-link" href="mailto:henriquejcpacheco@gmail.com">Get in touch</a>

      <h2 class="section-heading projects-heading">Side Projects</h2>
      <p class="projects-intro">Two products I build in my spare time.</p>
      <div class="project-item">
        <h3 class="project-name"><a href="https://lume-app.dev/" target="_blank" rel="noopener noreferrer">Lume</a></h3>
        <p class="project-platforms">Mac App Store, June 2026 · iPhone, September 2026</p>
        <p class="project-desc">I build Lume, a private net-worth and FIRE (Financial Independence, Retire Early) tracker for anyone working towards financial independence. It reads your own bank and broker statements on the device, so every figure shows the statement lines behind it. No bank login and no subscription; sync is optional and end-to-end encrypted.</p>
        <p class="project-desc">Under the hood, it's a React and TypeScript app in Tauri 2, with a thin Rust layer that talks to macOS and iOS. It imports PDF, CSV, Excel and OFX statements, and encrypts your data on the device (Argon2id and AES-GCM) before it syncs through Supabase, so the server only holds data it can't read.</p>
      </div>
      <div class="project-item">
        <h3 class="project-name"><a href="https://good-work.app/" target="_blank" rel="noopener noreferrer">Good Work</a></h3>
        <p class="project-platforms">Web, June 2025</p>
        <p class="project-desc">I build Good Work, a dashboard for your whole life, not just your habits. You pick the few things you care about and log them in seconds. Every quarter, you see what's improving and what slipped, without a streak to break.</p>
        <p class="project-desc">It's a Next.js and React app in TypeScript, with Postgres and sign-in on Supabase, Stripe for the Premium plan, and Withings for health data. The interface is built with shadcn/ui and Tailwind, and it runs on Vercel.</p>
      </div>

      <h2 class="section-heading exp-heading">Experience</h2>
      <div class="experience-list" id="experience-list">
        {experiences.map((exp, idx) => (
          <div class="exp-item" data-idx={idx}>
            <button type="button" class="exp-header" aria-expanded="false" aria-controls={`exp-panel-${idx}`}>
              <span class="exp-title-wrap">
                <span class="exp-title">{exp.title}</span>
                <span class="exp-skills">{exp.skills}</span>
              </span>
              <span class="exp-dates">{exp.from} – {exp.to}</span>
            </button>
            <div class="exp-panel" id={`exp-panel-${idx}`} aria-hidden="true" inert>
              {exp.items.map((item) => (
                <p class="exp-item-text">— {item}</p>
              ))}
            </div>
          </div>
        ))}
      </div>

      <h2 class="section-heading">Social</h2>
      <ul class="social-list">
        <li><a class="social-link" href="https://github.com/ikas" target="_blank" rel="noopener noreferrer">Github</a></li>
        <li><a class="social-link" href="https://www.linkedin.com/in/henrique-pacheco/" target="_blank" rel="noopener noreferrer">Linkedin</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about-page {
    padding: var(--space-6) 0 var(--space-7);
  }

  .container {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .section-heading {
    font-family: var(--font-body);
    font-size: 3.052rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .build-heading {
    margin-top: var(--space-6);
  }

  .projects-heading {
    margin-top: var(--space-6);
  }

  .exp-heading {
    margin-top: var(--space-6);
  }

  .project-item {
    margin-bottom: var(--space-5);
  }

  .projects-intro {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-primary);
    margin: 0 0 var(--space-4);
  }

  .project-name {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
  }

  .project-name a {
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .project-name a:hover {
    opacity: 0.6;
  }

  .project-platforms {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-secondary);
    margin: 0 0 var(--space-2);
  }

  .project-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-primary-70);
    margin: 0;
  }

  .project-desc + .project-desc {
    margin-top: var(--space-2);
  }

  .bio {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-primary);
    margin: 0 0 var(--space-3);
  }

  .contact-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 3px solid var(--color-primary);
    padding-bottom: 2px;
    transition: opacity var(--transition);
    margin-top: var(--space-2);
  }

  .contact-link:hover {
    opacity: 0.6;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .exp-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: none;
    user-select: none;
  }

  .exp-header:focus-visible {
    outline: 1px solid var(--color-primary);
    outline-offset: var(--space-1);
  }

  .exp-title,
  .exp-skills {
    display: block;
  }

  .exp-title-wrap {
    flex: 1;
  }

  .exp-title {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 var(--space-1);
    transition: opacity var(--transition);
  }

  .exp-header:hover .exp-title,
  .exp-item.open .exp-title {
    opacity: 0.7;
  }

  .exp-skills {
    font-size: 0.9rem;
    color: var(--color-secondary);
    margin: 0;
  }

  .exp-dates {
    font-size: 1rem;
    color: var(--color-primary-70);
    white-space: nowrap;
    margin: 0;
  }

  .exp-panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s ease-in-out, opacity 0.4s ease-in-out;
  }

  .exp-item.open .exp-panel {
    max-height: 1000px;
    opacity: 1;
  }

  .exp-item-text {
    font-size: 1.1rem;
    color: var(--color-primary);
    margin: var(--space-3) 0 0;
    line-height: 1.5;
  }

  .social-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social-link {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .social-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 544px) {
    .exp-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  document.querySelectorAll('.exp-item').forEach((item) => {
    const header = item.querySelector('.exp-header');
    const panel = item.querySelector('.exp-panel');
    header?.addEventListener('click', () => {
      const open = item.classList.toggle('open');
      header.setAttribute('aria-expanded', String(open));
      panel?.setAttribute('aria-hidden', String(!open));
      panel?.toggleAttribute('inert', !open);
    });
  });
</script>
