---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Henrique Pacheco`}
  description={post.data.description}
  currentUrl={`/blog/${post.id}`}
>
  <article class="post-page">
    <div class="container">
      {post.data.image && (
        <div class="post-hero" style={`background-image: url(${post.data.image})`}></div>
      )}
      <header class="post-header">
        <span class="post-category">{post.data.category}</span>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-meta">
          {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          {post.data.author && <span> · {post.data.author}</span>}
        </p>
      </header>
      <div class="post-content">
        <Content />
      </div>
      <a class="back-link" href="/blog">← Back to Blog</a>
    </div>
  </article>
</Layout>

<style>
  .post-page {
    padding: var(--space-5) 0 var(--space-7);
  }

  .container {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .post-hero {
    width: 100%;
    height: 320px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 8px;
    margin-bottom: var(--space-5);
  }

  .post-header {
    margin-bottom: var(--space-5);
  }

  .post-category {
    display: inline-flex;
    background: var(--color-secondary);
    color: var(--color-white);
    padding: 4px 8px;
    font-size: 14px;
    line-height: 16px;
    border-radius: 5px;
    margin-bottom: var(--space-3);
  }

  .post-title {
    font-family: var(--font-body);
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-2);
    line-height: 1.1;
  }

  .post-meta {
    font-size: 1rem;
    color: var(--color-primary-70);
    margin: 0;
  }

  .post-content {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-primary);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    font-family: var(--font-body);
    font-weight: 700;
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
  }

  .post-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-content :global(a) {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--transition);
  }

  .post-content :global(a:hover) {
    opacity: 0.6;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 5px;
    margin: var(--space-4) 0;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-secondary);
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-primary-70);
    font-style: italic;
  }

  .post-content :global(code) {
    background: rgba(48, 61, 93, 0.08);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background: rgba(48, 61, 93, 0.08);
    padding: var(--space-4);
    border-radius: 5px;
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .back-link {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .back-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 544px) {
    .post-title { font-size: 1.75rem; }
    .post-hero { height: 200px; }
  }
</style>
