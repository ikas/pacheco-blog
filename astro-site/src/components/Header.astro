---
interface Props {
  currentUrl?: string;
}
const { currentUrl = '/' } = Astro.props;

const isActive = (path: string) => currentUrl === path || currentUrl.startsWith(path + '/');
---

<header>
  <nav>
    <a href="/" class:list={['nav-link', { active: isActive('/') && currentUrl === '/' }]}>Home</a>
    <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Blog</a>
    <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-5) var(--space-4) 0;
    position: relative;
    z-index: 1;
  }

  nav {
    display: flex;
    gap: var(--space-4);
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    position: relative;
    opacity: 1;
    transition: opacity var(--transition);
  }

  .nav-link::after {
    content: '';
    display: block;
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-primary);
    transform: scale3d(0, 1, 1);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scale3d(1, 1, 1);
  }

  @media (max-width: 544px) {
    header {
      padding: var(--space-4) var(--space-3) 0;
    }
    nav {
      gap: var(--space-3);
    }
  }
</style>
