---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout currentUrl="/">
  <div class="home-wrapper">
    <section class="hero">
      <h1 class="hero-name">Henrique<br />Pacheco</h1>
      <p class="hero-sub">Software Engineer from Portugal</p>
    </section>
    <div class="scroll-indicator">
      <span class="scroll-text">Scroll</span>
      <span class="scroll-dot"></span>
    </div>
  </div>

  <section class="blog-gallery">
    <div class="container">
      <h2 class="gallery-heading">Blog</h2>
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-card">
            {post.data.image && (
              <div class="post-card-image" style={`background-image: url(${post.data.image})`}></div>
            )}
            <div class="post-card-info">
              <h3 class="post-card-title">{post.data.title}</h3>
              <span class="post-category">{post.data.category}</span>
              <p class="post-card-date">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-wrapper {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 80px);
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-5);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    justify-content: center;
    padding: var(--space-5) var(--space-4);
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: 155px;
    line-height: 152px;
    text-transform: uppercase;
    margin: 0;
    background: linear-gradient(to right, var(--color-primary), var(--color-secondary), var(--color-tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 6px transparent;
    -webkit-text-fill-color: white;
    color: var(--color-primary);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 30px;
    line-height: 33px;
    color: var(--color-primary-90);
    width: 50%;
    margin: var(--space-4) auto 0;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: var(--space-4);
  }

  .scroll-text {
    font-size: 28px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .scroll-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-top: var(--space-4);
  }

  .blog-gallery {
    margin-bottom: var(--space-7);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .gallery-heading {
    font-family: var(--font-body);
    font-size: 3.052rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .posts-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .post-card {
    flex-basis: 45%;
    box-shadow: 0 0 10px 0 var(--color-primary-50);
    border-radius: 5px;
    margin: 0 12px 24px;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition);
    display: block;
  }

  .post-card:hover {
    transform: scale(1.02);
    opacity: 0.8;
  }

  .post-card-image {
    height: 200px;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 5px 5px 0 0;
  }

  .post-card-info {
    padding: 16px;
  }

  .post-card-title {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }

  .post-category {
    display: inline-flex;
    background: var(--color-secondary);
    color: var(--color-white);
    padding: 4px 8px;
    font-size: 14px;
    line-height: 16px;
    border-radius: 5px;
    margin-top: var(--space-2);
  }

  .post-card-date {
    font-size: 1rem;
    color: var(--color-primary-70);
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 768px) {
    .hero-name { font-size: 100px; line-height: 100px; -webkit-text-stroke: 4px transparent; }
    .hero-sub { font-size: 26px; line-height: 29px; width: 80%; }
    .post-card { flex-basis: 100%; }
  }

  @media (max-width: 544px) {
    .hero-name { font-size: 56px; line-height: 56px; -webkit-text-stroke: 2px transparent; }
    .hero-sub { font-size: 20px; line-height: 22px; }
  }
</style>
